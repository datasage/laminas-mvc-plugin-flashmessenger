{
    "name": "laminas/laminas-mvc-plugin-flashmessenger",
    "description": "Plugin for creating and exposing flash messages via laminas-mvc controllers",
    "license": "BSD-3-Clause",
    "keywords": [
        "laminas",
        "mvc"
    ],
    "homepage": "https://laminas.dev",
    "support": {
        "docs": "https://docs.laminas.dev/laminas-mvc-plugin-flashmessenger/",
        "issues": "https://github.com/laminas/laminas-mvc-plugin-flashmessenger/issues",
        "source": "https://github.com/laminas/laminas-mvc-plugin-flashmessenger",
        "rss": "https://github.com/laminas/laminas-mvc-plugin-flashmessenger/releases.atom",
        "chat": "https://laminas.dev/chat",
        "forum": "https://discourse.laminas.dev"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.99"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laminas": {
            "component": "Laminas\\Mvc\\Plugin\\FlashMessenger"
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "laminas/laminas-mvc": "^3.8 || ^4.0",
        "laminas/laminas-servicemanager": "^3.24",
        "laminas/laminas-session": "^2.26",
        "laminas/laminas-stdlib": "^3.21",
        "laminas/laminas-view": "^2.44",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "amphp/dns": "^2.4",
        "amphp/socket": "^2.4",
        "laminas/laminas-coding-standard": "^3.1",
        "laminas/laminas-i18n": "^2.31",
        "phpunit/phpunit": "^12.0 || ^13.0",
        "psalm/plugin-phpunit": "^0.19",
        "vimeo/psalm": "^6.14"
    },
    "conflict": {
        "laminas/laminas-mvc": "<3.0.0",
        "zendframework/zend-mvc-plugin-flashmessenger": "*"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\Mvc\\Plugin\\FlashMessenger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\Mvc\\Plugin\\FlashMessenger\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@static-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "psalm --shepherd --stats",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/datasage/laminas-mvc",
            "no-api": true
        }
    ],
    "suggest": {
        "laminas/laminas-i18n": "To translate messages rendered by the FlashMessenger view helper"
    }
}
